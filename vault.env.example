# vault.env.example: the ctxredact vault template.
# Copy to vault.env (root:root 0600) and fill in REAL values as root.
#
# PARSER RULES (read before filling in):
#   * Lines are KEY=value. The value is LITERAL to end of line.
#   * '#' starts a comment ONLY at the beginning of a line (column 0).
#     A '#' with leading spaces is NOT a comment.
#   * Inline comments are NOT supported: KEY=value  # comment
#     would make "value  # comment" the actual secret. Keep comments
#     on their own line (like this one).
#   * Blank lines are ignored. No quoting needed; '=' is allowed in values.
#
# PURPOSE FIELD (optional but recommended): a comment line IMMEDIATELY ABOVE a
#   key becomes that credential's purpose, shown to the agent by list_secrets
#   so it picks the right key. Rules:
#   * The comment must be directly above the key (no blank line in between;
#     a blank line detaches it).
#   * It is NON-SECRET: visible to the agent and to the model it calls. NEVER
#     put a value, a partial value, or a hint at a value here. Only what the
#     credential is FOR.
#   * Only '#' at column 0 binds (no leading spaces).
#
# The setuid broker reads ONLY the compiled-in SECRETS_PATH (it ignores
# CTXREDACT_SECRETS in setuid mode), so this file must live at that path.

# shared SSH/lab password
LAB_PASS=change-me
# Admin user for the network switch (comment directly above = purpose)
SWITCH_USER=change-me
SWITCH_PASS=change-me
# API credentials for the monitoring platform
MONITORING_USER=change-me
MONITORING_TOKEN=change-me
# Database read-only credentials
DB_USER=change-me
DB_PASS=change-me
# Outbound SMTP (uses password auth, not a token)
SMTP_USER=change-me
SMTP_PASS=change-me
# Cloud object-store token
OBJECTSTORE_TOKEN=change-me
# Webhook signing secret for alert delivery
ALERT_WEBHOOK_SECRET=change-me
# Long-lived API key used by the automation bridge
BRIDGE_API_KEY=change-me
# Bitwarden Secrets Manager bootstrap (only needed for the --bitwarden source).
# The token is a real credential; the project id is a UUID.
BITWARDEN_TOKEN=change-me
BITWARDEN_PROJECT_ID=00000000-0000-0000-0000-000000000000
